        <mxCell id="m3" value="3: SELECT * FROM documents WHERE documentId = id" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=11;fontColor=#17365D;" edge="1" parent="1">
