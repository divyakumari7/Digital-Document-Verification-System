        <mxCell id="m4_db_ret" value="6d: logPersisted" style="endArrow=open;dashed=1;html=1;strokeWidth=1.2;strokeColor=#888888;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="1020" as="sourcePoint" /><mxPoint x="887" y="1020" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4_ret_srv" value="7d: HTTP 200 {result: 'Verified', metadata: {type, recipient, issueDate, org}}" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#229954;fontSize=11;fontColor=#229954;" edge="1" parent="1">
