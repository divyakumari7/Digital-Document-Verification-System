        <mxCell id="m1_db_ret" value="6a: logPersisted" style="endArrow=open;dashed=1;html=1;strokeWidth=1.2;strokeColor=#888888;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="450" as="sourcePoint" /><mxPoint x="887" y="450" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m1_ret_srv" value="7a: HTTP 404 {result: 'Not Found'}" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#C0392B;fontSize=11;fontColor=#C0392B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="873" y="480" as="sourcePoint" /><mxPoint x="510" y="480" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m1_ret_cli" value="8a: render 'Not Found' Error Message" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#C0392B;fontSize=11;fontColor=#C0392B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="510" as="sourcePoint" /><mxPoint x="160" y="510" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- DIVIDER 1 -->
        <mxCell id="div1" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#2F5597;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="540" as="sourcePoint" /><mxPoint x="1340" y="540" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERAND 2: TAMPERED -->
        <mxCell id="lbl_op2" value="[case 2: file != null AND computeHash(file) != storedHash / Tampered]" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#C0392B;" vertex="1" parent="1">
          <mxGeometry x="160" y="550" width="450" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m2_self" value="5b: computeSHA256Hash(file)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.4;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="930" y="580" /><mxPoint x="930" y="605" /></Array>
            <mxPoint x="887" y="580" as="sourcePoint" /><mxPoint x="887" y="605" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_db" value="6b: INSERT INTO verification_logs (status='Tampered', timestamp, hashMismatch=true)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="887" y="630" as="sourcePoint" /><mxPoint x="1250" y="630" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2_db_ret" value="7b: logPersisted" style="endArrow=open;dashed=1;html=1;strokeWidth=1.2;strokeColor=#888888;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="660" as="sourcePoint" /><mxPoint x="887" y="660" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2_ret_srv" value="8b: HTTP 200 {result: 'Tampered', warning: 'Integrity Failure'}" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#C0392B;fontSize=11;fontColor=#C0392B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="873" y="690" as="sourcePoint" /><mxPoint x="510" y="690" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2_ret_cli" value="9b: render 'Tampered' Warning Notice" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#C0392B;fontSize=11;fontColor=#C0392B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="720" as="sourcePoint" /><mxPoint x="160" y="720" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- DIVIDER 2 -->
        <mxCell id="div2" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#2F5597;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="750" as="sourcePoint" /><mxPoint x="1340" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERAND 3: INVALID / REVOKED -->
        <mxCell id="lbl_op3" value="[case 3: record.status == 'Revoked' OR record.status == 'Invalid']" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#B7950B;" vertex="1" parent="1">
          <mxGeometry x="160" y="760" width="450" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m3_db" value="5c: INSERT INTO verification_logs (status='Invalid', timestamp, reason='Revoked')" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="887" y="800" as="sourcePoint" /><mxPoint x="1250" y="800" as="targetPoint" /></mxGeometry>
