        </mxCell>

        <!-- OPERAND 1: NOT FOUND -->
        <mxCell id="lbl_op1" value="[case 1: documentRecord == null / Not Found]" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#C0392B;" vertex="1" parent="1">
          <mxGeometry x="160" y="380" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m1_db" value="5a: INSERT INTO verification_logs (status='Not Found', timestamp, ip)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1">
