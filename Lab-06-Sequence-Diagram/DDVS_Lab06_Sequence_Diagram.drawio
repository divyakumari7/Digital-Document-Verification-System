        <mxCell id="m4_db" value="5d: INSERT INTO verification_logs (status='Verified', timestamp, docId)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="887" y="980" as="sourcePoint" /><mxPoint x="1250" y="980" as="targetPoint" /></mxGeometry>
