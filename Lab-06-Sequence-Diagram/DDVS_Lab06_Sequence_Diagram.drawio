          <mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="830" as="sourcePoint" /><mxPoint x="887" y="830" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3_ret_srv" value="7c: HTTP 200 {result: 'Invalid', status: 'Revoked'}" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#B7950B;fontSize=11;fontColor=#B7950B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="873" y="860" as="sourcePoint" /><mxPoint x="510" y="860" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3_ret_cli" value="8c: render 'Invalid / Revoked' Screen" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#B7950B;fontSize=11;fontColor=#B7950B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="890" as="sourcePoint" /><mxPoint x="160" y="890" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- DIVIDER 3 -->
        <mxCell id="div3" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#2F5597;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="920" as="sourcePoint" /><mxPoint x="1340" y="920" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERAND 4: VERIFIED (MAIN SUCCESS) -->
        <mxCell id="lbl_op4" value="[case 4: (file == null OR computeHash(file) == storedHash) AND record.status == 'Active' / Verified]" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#229954;" vertex="1" parent="1">
          <mxGeometry x="160" y="930" width="650" height="20" as="geometry" />
