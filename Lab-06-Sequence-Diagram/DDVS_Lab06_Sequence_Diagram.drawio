        <!-- COMBINED FRAGMENT: ALT -->
        <mxCell id="alt_frame" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=30;fillColor=none;strokeColor=#2F5597;strokeWidth=1.8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
