        <mxCell id="m1" value="1: submitVerification(docId, qrCode, file)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=11;fontColor=#17365D;" edge="1" parent="1">
