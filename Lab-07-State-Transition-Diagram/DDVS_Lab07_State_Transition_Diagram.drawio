<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-11-01T22:00:00.000Z" agent="Mozilla/5.0" version="24.7.17" type="device">
  <diagram id="ddvs-state-diagram" name="UML State Machine Diagram - Verification Request">
    <mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="UML STATE MACHINE DIAGRAM — VERIFICATION REQUEST PROCESSING LIFECYCLE" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="950" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Software Engineering Practical Lab 07 | States, Events, Guard Conditions &amp; Audit Transitions in DDVS" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="350" y="50" width="750" height="20" as="geometry" />
        </mxCell>

        <!-- Initial Pseudostate -->
        <mxCell id="init" value="" style="ellipse;fillColor=#17365D;strokeColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="695" y="100" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- State 1: Idle / AwaitingInput -->
        <mxCell id="st_idle" value="&lt;b&gt;Idle / AwaitingInput&lt;/b&gt;&#xa;&lt;hr/&gt;entry / initializeVerificationUI()&#xa;do / listenForSubmission()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#2F5597;strokeWidth=1.5;fontSize=11;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- State 2: RequestReceived -->
        <mxCell id="st_recv" value="&lt;b&gt;RequestReceived&lt;/b&gt;&#xa;&lt;hr/&gt;entry / parsePayload()&#xa;do / validateFormat()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#2F5597;strokeWidth=1.5;fontSize=11;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="600" y="270" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- State 3: RecordLookup -->
        <mxCell id="st_lookup" value="&lt;b&gt;RecordLookup&lt;/b&gt;&#xa;&lt;hr/&gt;entry / connectDB()&#xa;do / queryByDocumentId()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#2F5597;strokeWidth=1.5;fontSize=11;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- State 4: IntegrityChecking -->
        <mxCell id="st_hash" value="&lt;b&gt;IntegrityChecking&lt;/b&gt;&#xa;&lt;hr/&gt;entry / readUploadedBytes()&#xa;do / computeSHA256() &amp; compare()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#2F5597;strokeWidth=1.5;fontSize=11;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="600" y="520" width="240" height="65" as="geometry" />
        </mxCell>

        <!-- State 5: StatusEvaluation -->
        <mxCell id="st_status" value="&lt;b&gt;StatusEvaluation&lt;/b&gt;&#xa;&lt;hr/&gt;entry / readRecordStatus()&#xa;do / verifyActiveFlag()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#2F5597;strokeWidth=1.5;fontSize=11;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="1050" y="520" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- OUTCOME STATES -->
        <!-- Outcome 1: NotFound -->
        <mxCell id="st_notfound" value="&lt;b&gt;NotFound&lt;/b&gt;&#xa;&lt;hr/&gt;entry / flagResult('Not Found')&#xa;do / prepareErrorView()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=1.5;fontSize=11;fontColor=#922B21;" vertex="1" parent="1">
          <mxGeometry x="120" y="520" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Outcome 2: Tampered -->
        <mxCell id="st_tampered" value="&lt;b&gt;Tampered&lt;/b&gt;&#xa;&lt;hr/&gt;entry / flagResult('Tampered')&#xa;do / prepareWarningNotice()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=1.5;fontSize=11;fontColor=#922B21;" vertex="1" parent="1">
          <mxGeometry x="380" y="680" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Outcome 3: Invalid -->
        <mxCell id="st_invalid" value="&lt;b&gt;Invalid&lt;/b&gt;&#xa;&lt;hr/&gt;entry / flagResult('Invalid')&#xa;do / prepareRevokedNotice()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#B7950B;strokeWidth=1.5;fontSize=11;fontColor=#7D6608;" vertex="1" parent="1">
          <mxGeometry x="780" y="680" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Outcome 4: Verified -->
        <mxCell id="st_verified" value="&lt;b&gt;Verified&lt;/b&gt;&#xa;&lt;hr/&gt;entry / flagResult('Verified')&#xa;do / prepareSuccessMetadata()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#229954;strokeWidth=1.5;fontSize=11;fontColor=#145A32;" vertex="1" parent="1">
          <mxGeometry x="1150" y="680" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- State 6: Logged & Terminated -->
        <mxCell id="st_logged" value="&lt;b&gt;Logged &amp; Terminated&lt;/b&gt;&#xa;&lt;hr/&gt;entry / commitAuditLog(D3)&#xa;do / renderFinalResponse()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#2F5597;strokeWidth=1.8;fontSize=12;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="580" y="870" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- Final State -->
        <mxCell id="final_state" value="" style="ellipse;html=1;shape=endState;fillColor=#17365D;strokeColor=#2F5597;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="695" y="990" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- TRANSITIONS -->
        <!-- init -> idle -->
        <mxCell id="t0" value="" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;" edge="1" parent="1" source="init" target="st_idle"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- idle -> recv -->
        <mxCell id="t1" value="submitVerification(id, qr, file)&#xa;[validInput] / extractID()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1" source="st_idle" target="st_recv"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- recv -> lookup -->
        <mxCell id="t2" value="executeDBQuery() / queryRecord()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1" source="st_recv" target="st_lookup"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- lookup -> notfound -->
        <mxCell id="t3" value="[recordNotFound] / setOutcome('Not Found')" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C0392B;fontSize=10;fontColor=#C0392B;" edge="1" parent="1" source="st_lookup" target="st_notfound">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="410" /></Array></mxGeometry>
        </mxCell>

        <!-- lookup -> hash -->
        <mxCell id="t4" value="[recordFound &amp;&amp; fileUploaded]&#xa;/ extractStoredHash()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1" source="st_lookup" target="st_hash"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- lookup -> status (bypass hash) -->
        <mxCell id="t5" value="[recordFound &amp;&amp; fileAbsent]&#xa;/ bypassHashCheck()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1" source="st_lookup" target="st_status">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="410" /></Array></mxGeometry>
        </mxCell>

        <!-- hash -> tampered -->
        <mxCell id="t6" value="[hashMismatch] / logSecurityAlert()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C0392B;fontSize=10;fontColor=#C0392B;" edge="1" parent="1" source="st_hash" target="st_tampered">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="555" /></Array></mxGeometry>
        </mxCell>

        <!-- hash -> status -->
        <mxCell id="t7" value="[hashMatches] / proceedToStatus()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#229954;fontSize=10;fontColor=#229954;" edge="1" parent="1" source="st_hash" target="st_status"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- status -> invalid -->
        <mxCell id="t8" value="[status == 'Revoked'] / flagRevoked()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B7950B;fontSize=10;fontColor=#B7950B;" edge="1" parent="1" source="st_status" target="st_invalid">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="620" /></Array></mxGeometry>
        </mxCell>

        <!-- status -> verified -->
        <mxCell id="t9" value="[status == 'Active'] / prepareCertificateView()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#229954;fontSize=10;fontColor=#229954;" edge="1" parent="1" source="st_status" target="st_verified">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1255" y="620" /></Array></mxGeometry>
        </mxCell>

        <!-- Outcomes -> logged -->
        <mxCell id="t_nf_log" value="persistLog() / writeDB()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1" source="st_notfound" target="st_logged">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="890" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="t_tp_log" value="persistLog() / writeDB()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1" source="st_tampered" target="st_logged">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="850" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="t_inv_log" value="persistLog() / writeDB()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1" source="st_invalid" target="st_logged">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="850" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="t_ver_log" value="persistLog() / writeDB()" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1" source="st_verified" target="st_logged">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1255" y="890" /></Array></mxGeometry>
        </mxCell>

        <!-- logged -> final -->
        <mxCell id="t_fin" value="sessionClosed" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F5597;fontSize=10;" edge="1" parent="1" source="st_logged" target="final_state"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>