        <!-- Title -->
        <mxCell id="title" value="UML ACTIVITY DIAGRAM — DOCUMENT VERIFICATION WORKFLOW" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#17365D;" vertex="1" parent="1">
